                    "type": "string"
                },
                "desired_salary": {
                    "type": "integer"
                },
                "education": {
                    "type": "string"
                },
                "experience_years": {
                    "type": "integer"
                },
                "id": {
                    "type": "string"
                },
                "is_active": {
                    "type": "boolean"
                },
                "skills": {
                    "type": "string"
                },
                "summary": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "github_com_study_jobboard_applicant-service_internal_model.UpdateProfileRequest": {
            "type": "object",
            "properties": {
                "about": {
                    "type": "string",
                    "example": "Backend developer"
                },
                "city": {
                    "type": "string",
                    "example": "Moscow"
                },
                "full_name": {
                    "type": "string",
                    "example": "Ivan Ivanov"
                },
                "phone": {
                    "type": "string",
                    "example": "+79001234567"
                }
            }
        },
        "github_com_study_jobboard_applicant-service_internal_model.UpsertResumeRequest": {
            "type": "object",
            "properties": {
                "desired_salary": {
                    "type": "integer",
                    "example": 150000
                },
                "education": {
                    "type": "string",
                    "example": "BS Computer Science"
                },
                "experience_years": {
                    "type": "integer",
                    "example": 2
                },
                "is_active": {
                    "type": "boolean",
                    "example": true
                },
                "skills": {
                    "type": "string",
                    "example": "Go, PostgreSQL, RabbitMQ"
                },
                "summary": {
                    "type": "string",
                    "example": "2 years of backend experience"
                },
                "title": {
                    "type": "string",
                    "example": "Go Developer"
                }

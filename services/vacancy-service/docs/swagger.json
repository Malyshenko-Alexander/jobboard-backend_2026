    "definitions": {
        "github_com_study_jobboard_vacancy-service_internal_model.CompanyInfo": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string"
                },
                "company_name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "website": {
                    "type": "string"
                }
            }
        },
        "github_com_study_jobboard_vacancy-service_internal_model.CreateVacancyRequest": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string",
                    "example": "Moscow"
                },
                "description": {
                    "type": "string",
                    "example": "Build microservices"
                },
                "experience_years": {
                    "type": "integer",
                    "example": 2
                },
                "industry": {
                    "type": "string",
                    "example": "IT"
                },
                "requirements": {
                    "type": "string",
                    "example": "Go, PostgreSQL"
                },
                "salary_from": {
                    "type": "integer",
                    "example": 150000
                },
                "salary_to": {
                    "type": "integer",
                    "example": 250000
                },
                "title": {
                    "type": "string",
                    "example": "Go Developer"
                }
            }
        },
        "github_com_study_jobboard_vacancy-service_internal_model.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "vacancy not found"
                }
            }
        },
        "github_com_study_jobboard_vacancy-service_internal_model.UpdateVacancyRequest": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string",
                    "example": "Moscow"
                },
                "description": {
                    "type": "string",
                    "example": "Lead backend work"
                },
                "experience_years": {
                    "type": "integer",
                    "example": 3
                },
                "industry": {
                    "type": "string",
                    "example": "IT"
                },
                "is_active": {
                    "type": "boolean",
                    "example": true
                },
                "requirements": {
                    "type": "string",
                    "example": "Go, RabbitMQ"
                },
                "salary_from": {
                    "type": "integer",
                    "example": 200000
                },
                "salary_to": {
                    "type": "integer",
                    "example": 300000
                },
                "title": {
                    "type": "string",
                    "example": "Senior Go Developer"
                }
            }
        },
        "github_com_study_jobboard_vacancy-service_internal_model.Vacancy": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "employer_id": {
                    "type": "string"
                },
                "experience_years": {
                    "type": "integer"
                },
                "id": {
                    "type": "string"
                },
                "industry": {
                    "type": "string"
                },
                "is_active": {
                    "type": "boolean"
                },
                "requirements": {
                    "type": "string"
                },
                "salary_from": {
                    "type": "integer"
                },
                "salary_to": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
